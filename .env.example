# vercel dev 用（このファイルを .env.local にコピーしてキーを入れる）
OPENAI_API_KEY=sk-ここにOpenAIのAPIキーを貼り付け
OPENAI_MODEL=gpt-4o
# 任意: 直近の利用額($)をポータルの「OpenAI状態」に出すとき（Organization Admin API Key）
# OPENAI_ADMIN_KEY=sk-admin-...

# 任意: 「Claude状態」に Anthropic(Claude) の利用額・トークンを出すとき（ゆうしゃレオ等）
# 組織管理者が発行する Admin API キー(sk-ant-admin...)。Usage & Cost レポート読取に使用。
# ANTHROPIC_ADMIN_KEY=sk-ant-admin-...
# Anthropicの「トークン切れ(残高不足)」アラート検知に使用（通常APIキー sk-ant-...）。
# ※これが未設定だとClaudeの残高切れアラートは出せません（OpenAIは OPENAI_API_KEY で検知）。
# ANTHROPIC_API_KEY=sk-ant-...

# --- PORTAL 自身の Supabase（認証・members 照合。本番では設定済みのはず）---
SUPABASE_URL=https://bckzazaghgomhyvdikmb.supabase.co
SUPABASE_ANON_KEY=sb_publishable_...(PORTALのpublishableキー)
SUPABASE_SERVICE_ROLE_KEY=（PORTALのservice_roleキー）

# --- プロダクト ダッシュボード（/api/metrics が読む先。service_role はサーバーのみ）---
METRICS_RELA_URL=https://xmuvgobfompdwhgxnpis.supabase.co
METRICS_RELA_SERVICE_KEY=（RELA本番の service_role キー）
# 将来 ゆうしゃレオ / お茶の販売 を追加するとき（同名ビュー3〜5つ＋下記を足すだけ）:
# METRICS_LEO_URL=https://xxxx.supabase.co
# METRICS_LEO_SERVICE_KEY=（レオの service_role キー）
# METRICS_TEA_URL=https://xxxx.supabase.co
# METRICS_TEA_SERVICE_KEY=（お茶の販売の service_role キー）
